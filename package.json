{
  "name": "lintlane",
  "version": "3.0.0",
  "description": "Pre-push checks for React apps: shared Biome preset, local lint and CI dashboard",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lintlane": "bin/cli.mjs"
  },
  "exports": {
    "./biome": "./presets/base.json",
    "./biome/strict": "./presets/strict.json",
    "./biome/next": "./presets/next.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "presets",
    "ui",
    "templates",
    "README.md"
  ],
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "node --test \"test/*.test.mjs\"",
    "test:e2e": "LINTLANE_E2E=1 node --test \"test/e2e.test.mjs\""
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.2.0 <3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "lintlane",
    "biome",
    "react",
    "lint",
    "format"
  ],
  "author": "Expo2Dev"
}
