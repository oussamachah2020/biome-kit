{
  "name": "preflight-kit",
  "version": "2.5.0",
  "description": "Pre-push checks for React apps: shared Biome preset, local lint and CI dashboard",
  "license": "MIT",
  "type": "module",
  "bin": {
    "preflight": "bin/cli.mjs",
    "preflight-kit": "bin/cli.mjs"
  },
  "exports": {
    "./biome": "./presets/base.json",
    "./biome/strict": "./presets/strict.json",
    "./biome/next": "./presets/next.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "presets",
    "ui",
    "templates",
    "README.md"
  ],
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.2.0 <3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "keywords": [
    "preflight",
    "biome",
    "react",
    "lint",
    "format"
  ],
  "author": "Expo2Dev"
}
